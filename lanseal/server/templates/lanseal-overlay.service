[Unit]
Description=LANSeal overlay gateway address (dummy interface lanseal0)
Before=strongswan.service dnsmasq.service network-online.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'ip link show lanseal0 >/dev/null 2>&1 || ip link add lanseal0 type dummy; ip addr replace @GW_OV@/32 dev lanseal0; ip link set lanseal0 up'
ExecStop=/bin/sh -c 'ip link del lanseal0 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
