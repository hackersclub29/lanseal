[Unit]
Description=LANSeal Printer Forward %i
Documentation=man:socat(1)
After=network-online.target strongswan.service
Wants=strongswan.service
Requires=strongswan.service

[Service]
Type=simple
# %i = port number (9100, 631, 80, 443, 161)
# Binds to VIRTUAL IP only (10.77.0.50) - NOT 0.0.0.0
# Change 10.77.0.50 to your Pi's assigned virtual IP
ExecStart=/usr/bin/socat \
    TCP-LISTEN:%i,bind=10.77.0.50,fork,reuseaddr \
    TCP:10.24.10.50:%i \
    UDP-LISTEN:%i,bind=10.77.0.50,fork,reuseaddr \
    UDP:10.24.10.50:%i
Restart=always
RestartSec=2
# Drop privileges
User=nobody
Group=nogroup
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/socat

[Install]
WantedBy=multi-user.target